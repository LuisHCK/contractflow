<%
    const currencyOpts = { currency: stage.displayCurrencyCode, symbol: stage.displayCurrencySymbol }
    const totalPaid = payments.reduce((sum, p) => sum + Number(p.amount || 0), 0)
    const totalDue  = Math.max(0, Number(stage.estimatedCost || 0) - totalPaid)
    const payPercent = Number(stage.estimatedCost) > 0
        ? Math.min(100, Math.round((totalPaid / Number(stage.estimatedCost)) * 100))
        : 0
%>
<div class="columns is-variable is-4 mb-5">
    <div class="column is-two-thirds">
        <div class="card">
            <div class="card-content">
                <div class="columns is-mobile mb-4">
                    <div class="column">
                        <p class="heading"><%= __('estimated_budget') %></p>
                        <p class="title is-4"><%= formatToCurrency(stage.estimatedCost, currencyOpts) %></p>
                    </div>
                    <div class="column">
                        <p class="heading"><%= __('invoice_total_amount') %></p>
                        <p class="title is-4"><%= formatToCurrency(totalPaid, currencyOpts) %></p>
                    </div>
                </div>

                <div class="mb-4">
                    <% if (totalDue > 0) { %>
                        <span class="tag is-danger is-light"><%= __('overview_over_budget', { amount: formatToCurrency(totalDue, currencyOpts) }) %></span>
                    <% } else { %>
                        <span class="tag is-success is-light"><%= __('overview_on_budget') %></span>
                    <% } %>
                </div>

                <progress class="progress is-small mb-4 <% if (payPercent >= 100) { %>is-danger<% } else if (payPercent >= 80) { %>is-warning<% } else { %>is-link<% } %>" value="<%= payPercent %>" max="100"><%= payPercent %>%</progress>
                <p class="help"><%= __('overview_budget_used', { value: `${payPercent}%` }) %></p>
            </div>
        </div>
    </div>
    <div class="column is-one-third">
        <div class="card">
            <div class="card-content">
                <p class="heading"><%= __('balance') %></p>
                <p class="title is-4 <%= totalDue > 0 ? 'has-text-danger' : 'has-text-success' %> mb-4"><%= formatToCurrency(totalDue, currencyOpts) %></p>
                <p class="heading"><%= __('payments_count') %></p>
                <p class="title is-4 mb-4"><%= payments.length %></p>
                <p class="heading"><%= __('progress') %></p>
                <p class="title is-4"><%= progress %>%</p>
            </div>
        </div>
    </div>
</div>

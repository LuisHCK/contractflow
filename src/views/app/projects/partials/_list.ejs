<% const statusStyles = {
    in_progress: "is-success",
    active: "is-success",
    on_hold: "is-warning",
    paused: "is-warning",
    planned: "is-info",
    completed: "is-link",
    canceled: "is-danger",
    delayed: "is-danger",
    archived: "is-dark"
}; %>

<div class="columns is-multiline is-variable is-4">
    <% if (projects && projects.length) { %>
        <% projects.forEach(function (project) {
            const statusKey = (project.status || "unknown").toLowerCase();
            const statusClass = statusStyles[statusKey] || "is-info";
            const projectStatusTranslationKey = `projects_status_${statusKey}`;
            const translatedProjectStatus = __(projectStatusTranslationKey);
            const translatedGenericStatus = __(statusKey);
            const statusLabel = translatedProjectStatus !== projectStatusTranslationKey
                ? translatedProjectStatus
                : translatedGenericStatus !== statusKey
                    ? translatedGenericStatus
                    : (project.status || __('status')).replace(/_/g, " ");
        %>
        <div class="column is-full-tablet is-half-desktop">
            <div class="card">
                <div class="card-content">
                    <div class="content">
                        <div class="columns is-mobile">
                            <div class="column">
                                <h4 class="title is-5 is-spaced"><%= project.name %></h4>
                                <% if (project.description) { %>
                                    <p class="subtitle is-6 has-text-grey"><%= project.description %></p>
                                <% } %>
                            </div>
                            <div class="column is-narrow">
                                <span class="tag <%= statusClass %> is-light is-uppercase"><%= statusLabel %></span>
                            </div>
                        </div>

                        <div>
                            <div class="is-flex is-justify-content-space-between mb-1">
                                <span class="is-size-7"><%= __('progress') %></span>
                                <span class="is-size-7"><%= project.progress %>%</span>
                            </div>
                            <progress class="progress is-small mb-0" value="<%= project.progress %>" max="100"><%= project.progress %>%</progress>
                        </div>

                        <div class="columns mt-3">
                            <div class="column">
                                <div class="media">
                                    <div class="media-left">
                                        <span class="icon">
                                            <%- include('../../../partials/icons/home-dollar.ejs') %>
                                        </span>
                                    </div>
                                    <div class="media-content">
                                        <p class="is-size-7 mb-1"><%= __('projects_list_estimated_cost') %></p>
                                        <p class="m-0"><%= formatToCurrency(project.estimatedCost, { currency: project.currencyCode, symbol: project.currencySymbol }) %></p>
                                    </div>
                                </div>
                            </div>

                            <div class="column">
                                <div class="media">
                                    <div class="media-left">
                                        <span class="icon">
                                            <%- include('../../../partials/icons/calendar.ejs') %>
                                        </span>
                                    </div>
                                    <div class="media-content">
                                        <p class="is-size-7 mb-1"><%= __('projects_create_start_date') %></p>
                                        <p class="m-0"><%= formatDate(project.startDate) %></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <footer class="card-footer">
                    <a href="/projects/show/<%= project.id %>" class="card-footer-item has-text-weight-semibold">
                        <%= __('projects_list_view_details') %>
                    </a>
                    <a href="/projects/edit/<%= project.id %>" class="card-footer-item has-text-weight-semibold">
                        <%= __('projects_edit') %>
                    </a>
                </footer>
            </div>
        </div>
        <% }); %>
    <% } else { %>
        <div class="column is-12">
            <div class="notification is-warning">
                <%= __('projects_list_no_projects') %>
            </div>
        </div>
    <% } %>
</div>

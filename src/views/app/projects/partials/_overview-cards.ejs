<%
    const estimated = Number(project.estimatedCost) || 0;
    const actual = Number(project.actualCost) || 0;
    const currencyOpts = { currency: project.currencyCode, symbol: project.currencySymbol };
    const budgetPercent = estimated > 0
        ? Math.min(100, Math.round((actual / estimated) * 100))
        : 0;
    const delta = estimated - actual;
    const statusStyles = {
        in_progress: 'is-success',
        on_hold: 'is-warning',
        planned: 'is-info',
        canceled: 'is-danger',
        delayed: 'is-danger'
    };
    const sClass = statusStyles[(project.status || '').toLowerCase()] || 'is-info';
%>
<div class="columns is-variable is-4 mb-5">
    <div class="column is-two-thirds">
        <div class="card">
            <div class="card-content">
                <div class="columns is-mobile mb-4">
                    <div class="column">
                        <p class="heading"><%= __('overview_estimated_cost') %></p>
                        <p class="title is-4"><%= formatToCurrency(estimated, currencyOpts) %></p>
                    </div>
                    <div class="column">
                        <p class="heading"><%= __('overview_actual_cost') %></p>
                        <p class="title is-4"><%= formatToCurrency(actual, currencyOpts) %></p>
                    </div>
                </div>

                <div class="mb-4">
                    <% if (delta > 0) { %>
                        <span class="tag is-success is-light"><%= __('overview_under_budget', { amount: formatToCurrency(delta, currencyOpts) }) %></span>
                    <% } else if (delta < 0) { %>
                        <span class="tag is-danger is-light"><%= __('overview_over_budget', { amount: formatToCurrency(Math.abs(delta), currencyOpts) }) %></span>
                    <% } else { %>
                        <span class="tag is-info is-light"><%= __('overview_on_budget') %></span>
                    <% } %>
                </div>

                <progress class="progress is-small mb-4 <% if (budgetPercent >= 100) { %>is-danger<% } else if (budgetPercent >= 80) { %>is-warning<% } else { %>is-link<% } %>" value="<%= budgetPercent %>" max="100"><%= budgetPercent %>%</progress>
                <p class="help"><%= __('overview_budget_used', { value: `${budgetPercent}%` }) %></p>
            </div>
        </div>
    </div>
    <div class="column is-one-third">
        <div class="card">
            <div class="card-content">
                <p class="heading"><%= __('overview_status') %></p>
                <span class="tag <%= sClass %> is-medium mb-4"><%= __(`projects_status_${project.status}`) %></span>
                <p class="heading"><%= __('overview_total_stages') %></p>
                <p class="title is-4"><%= stages.length %></p>
            </div>
        </div>
    </div>
</div>
